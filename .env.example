# ============================================================================
# Clave y configuración de Google Gemini API
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
# ============================================================================
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash

# ============================================================================
# Configuración de PostgreSQL (requerida por docker-compose.yml compartido)
# ============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_secret_password
POSTGRES_DB=cv_analyzer_db
POSTGRES_PORT=5433

# ============================================================================
# Configuración de pgAdmin (requerida por docker-compose.yml compartido)
# ============================================================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_secret_password
PGADMIN_PORT=5050
PGADMIN_SERVERS_JSON={"Servers":{"1":{"Name":"Local Postgres","Group":"Servers","Host":"postgres","Port":5432,"MaintenanceDB":"postgres","Username":"admin","SSLMode":"prefer"}}}
